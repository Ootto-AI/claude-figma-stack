# Copy to .env and fill in. For the GitHub Action, set these as repo secrets instead
# (Settings → Secrets and variables → Actions).

COMPOSIO_API_KEY=          # your Composio API key (wraps the Instagram Graph API)
IG_BUSINESS_ACCOUNT_ID=    # your Instagram Business/Creator account id
CONNECTED_ACCOUNT_ID=      # the Composio connected-account id for that IG account
USER_ID=                   # your Composio user id
IG_HANDLE=                 # your IG handle (no @) — so the bot never replies to your own comments
